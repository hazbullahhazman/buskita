# Optional: without this key, the demo uses the OpenStreetMap basemap.
# Restrict a Maps JavaScript API browser key to your allowed website origins.
VITE_GOOGLE_MAPS_API_KEY=
# Optional public HTTPS address used for shareable QR links.
VITE_PUBLIC_URL=
PORT=4317
# Vercel only: private server-side Upstash REST credentials. Never prefix with VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use a separate database or key for preview deployments.
BASKITA_STATE_KEY=baskita:demo:v1
